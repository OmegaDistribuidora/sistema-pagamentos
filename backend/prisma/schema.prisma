generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  ANALYST
  USER
}

enum MeiInvoiceStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CommercialAgreementStatus {
  PENDING  @map("PENDENTE")
  APPROVED @map("APROVADA")
  REJECTED @map("RECUSADA")

  @@map("status_acordo_comercial")
}

enum CommercialAgreementAudienceType {
  NETWORK          @map("REDE")
  SPECIFIC_CLIENTS @map("CLIENTES_ESPECIFICOS")

  @@map("tipo_destino_acordo_comercial")
}

enum CommercialAgreementType {
  INSERT           @map("ENCARTE")
  LOYALTY          @map("FIDELIZACAO")
  STORE_OUTFIT     @map("ENXOVAL_DE_LOJA")
  PRODUCT_REGISTRY @map("CADASTRO_DE_PRODUTOS")
  EXTRA_POINT      @map("PONTO_EXTRA")
  OTHER            @map("OUTROS")

  @@map("tipo_acordo_comercial")
}

enum CommercialAgreementAttachmentCategory {
  INVOICES     @map("BOLETOS")
  TAX_INVOICE  @map("NOTA_FISCAL")
  CONTRACT     @map("CONTRATO_TERMO_OCORRENCIA")
  SALES_REPORT @map("RELATORIO_DE_VENDAS")
  PHOTOS       @map("FOTOS")

  @@map("categoria_anexo_acordo_comercial")
}

model User {
  id                            Int                          @id @default(autoincrement())
  username                      String                       @unique
  displayName                   String
  passwordHash                  String
  role                          UserRole                     @default(USER)
  supervisorCode                Int?
  supervisorCodes               Int[]                        @default([])
  canReviewPayments             Boolean                      @default(false)
  canViewPaymentHistory         Boolean                      @default(false)
  canAccessCommercialAgreements Boolean                      @default(false) @map("pode_acessar_acordos_comerciais")
  active                        Boolean                      @default(true)
  auditLogs                     AuditLog[]
  importedMeiBatches            MeiImportBatch[]             @relation("MeiBatchImporter")
  uploadedMeiInvoices           MeiInvoiceSubmission[]       @relation("MeiInvoiceUploader")
  reviewedMeiInvoices           MeiInvoiceSubmission[]       @relation("MeiInvoiceReviewer")
  sentMeiExtractEmails          MeiExtractEmailDispatch[]    @relation("MeiExtractEmailSender")
  requestedCommercialAgreements CommercialAgreement[]        @relation("CommercialAgreementRequester")
  reviewedCommercialAgreements  CommercialAgreement[]        @relation("CommercialAgreementReviewer")
  commercialAgreementHistory    CommercialAgreementHistory[] @relation("CommercialAgreementHistoryActor")
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt

  @@index([role, active])
  @@index([supervisorCode])
}

model PaymentHistoryRecord {
  id                Int      @id @default(autoincrement())
  coordinatorCode   Int
  region            String
  supervisorCode    Int
  supervisorName    String
  personCode        Int
  personName        String
  personType        String
  delinquencyAmount Decimal  @default(0) @db.Decimal(18, 2)
  meiDiscountAmount Decimal  @default(0) @db.Decimal(18, 2)
  totalAmount       Decimal  @db.Decimal(18, 2)
  amountToPay       Decimal  @db.Decimal(18, 2)
  month             Int
  year              Int
  event             String
  supplier          String
  paymentMethod     String
  releaseBy         String
  sourceUser        String
  registeredAt      DateTime @db.Date
  paidAt            DateTime @db.Date
  competenceAt      DateTime @db.Date
  notes             String?
  origin            String   @default("MANUAL")
  sourceFileName    String?
  createdByUsername String?
  updatedByUsername String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([year, month])
  @@index([event, personCode, year, month])
  @@index([supervisorCode, year, month])
  @@index([personName])
  @@index([paymentMethod])
}

model AuditLog {
  id               Int       @id @default(autoincrement())
  actorUserId      Int?
  actorUsername    String?
  actorDisplayName String?
  actorRole        UserRole?
  action           String
  entityType       String
  entityId         String?
  summary          String
  before           Json?
  after            Json?
  metadata         Json?
  actorUser        User?     @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model MeiImportBatch {
  id               Int                  @id @default(autoincrement())
  referenceMonth   String               @unique
  originalFileName String
  spreadsheetPath  String
  totalRows        Int
  importedByUserId Int
  importedByUser   User                 @relation("MeiBatchImporter", fields: [importedByUserId], references: [id], onDelete: Restrict)
  entries          MeiCommissionEntry[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([createdAt])
}

model MeiCommissionEntry {
  id                       Int                       @id @default(autoincrement())
  batchId                  Int
  periodStart              String?
  periodEnd                String?
  supervisorCode           Int
  vendorCode               Int
  vendorName               String
  grossSales               Decimal                   @db.Decimal(18, 2)
  returnsAmount            Decimal                   @db.Decimal(18, 2)
  netSales                 Decimal                   @db.Decimal(18, 2)
  advanceAmount            Decimal                   @db.Decimal(18, 2)
  delinquencyAmount        Decimal                   @db.Decimal(18, 2)
  grossCommission          Decimal                   @db.Decimal(18, 2)
  averageCommissionPercent Decimal                   @db.Decimal(9, 4)
  reversalAmount           Decimal                   @db.Decimal(18, 2)
  totalCommissionToInvoice Decimal                   @db.Decimal(18, 2)
  commissionToReceive      Decimal                   @db.Decimal(18, 2)
  batch                    MeiImportBatch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  submissions              MeiInvoiceSubmission[]
  emailDispatches          MeiExtractEmailDispatch[]
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  @@unique([batchId, vendorCode])
  @@index([batchId, supervisorCode])
  @@index([vendorCode])
}

model MeiVendorEmail {
  id         Int      @id @default(autoincrement())
  vendorCode Int      @unique
  email      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([email])
}

model VendorDirectoryEntry {
  id             Int      @id @default(autoincrement())
  supervisorCode Int
  vendorCode     Int      @unique
  vendorName     String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([supervisorCode, vendorName])
}

model MeiExtractEmailDispatch {
  id                Int                @id @default(autoincrement())
  entryId           Int
  sentByUserId      Int
  toEmail           String
  provider          String
  status            String
  providerMessageId String?
  errorMessage      String?
  requestedAt       DateTime           @default(now())
  sentAt            DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  entry             MeiCommissionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  sentByUser        User               @relation("MeiExtractEmailSender", fields: [sentByUserId], references: [id], onDelete: Restrict)

  @@index([entryId, createdAt])
  @@index([sentByUserId, createdAt])
  @@index([toEmail, createdAt])
}

model MeiInvoiceSubmission {
  id               Int                @id @default(autoincrement())
  entryId          Int
  uploadedByUserId Int
  reviewedByUserId Int?
  status           MeiInvoiceStatus   @default(PENDING)
  isCurrent        Boolean            @default(true)
  originalFileName String
  storagePath      String
  mimeType         String
  sizeBytes        Int
  rejectionReason  String?
  submittedAt      DateTime           @default(now())
  reviewedAt       DateTime?
  entry            MeiCommissionEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  uploadedByUser   User               @relation("MeiInvoiceUploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  reviewedByUser   User?              @relation("MeiInvoiceReviewer", fields: [reviewedByUserId], references: [id], onDelete: SetNull)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([entryId, isCurrent])
  @@index([status, isCurrent])
}

model CommercialAgreement {
  id                   Int                             @id @default(autoincrement()) @map("id")
  requesterUserId      Int?                            @map("usuario_solicitante_id")
  requesterUsername    String                          @map("usuario_solicitante_login")
  requesterDisplayName String                          @map("usuario_solicitante_nome")
  audienceType         CommercialAgreementAudienceType @map("tipo_destino")
  networkCode          Int?                            @map("codigo_rede")
  agreementType        CommercialAgreementType         @map("tipo_acordo")
  otherDescription     String?                         @map("descricao_outros")
  totalAmount          Decimal                         @map("valor_total") @db.Decimal(18, 2)
  splitAmount          Boolean                         @default(false) @map("ratear_valor")
  notes                String?                         @map("observacao")
  status               CommercialAgreementStatus       @default(PENDING) @map("status")
  rejectionReason      String?                         @map("motivo_recusa")
  submittedAt          DateTime                        @default(now()) @map("enviado_em") @db.Timestamptz(3)
  reviewedAt           DateTime?                       @map("analisado_em") @db.Timestamptz(3)
  resubmittedAt        DateTime?                       @map("reenviado_em") @db.Timestamptz(3)
  reviewerUserId       Int?                            @map("usuario_analista_id")
  reviewerUsername     String?                         @map("usuario_analista_login")
  reviewerDisplayName  String?                         @map("usuario_analista_nome")
  createdAt            DateTime                        @default(now()) @map("criado_em") @db.Timestamptz(3)
  updatedAt            DateTime                        @updatedAt @map("atualizado_em") @db.Timestamptz(3)
  requester            User?                           @relation("CommercialAgreementRequester", fields: [requesterUserId], references: [id], onDelete: SetNull)
  reviewer             User?                           @relation("CommercialAgreementReviewer", fields: [reviewerUserId], references: [id], onDelete: SetNull)
  clients              CommercialAgreementClient[]
  suppliers            CommercialAgreementSupplier[]
  products             CommercialAgreementProduct[]
  attachments          CommercialAgreementAttachment[]
  history              CommercialAgreementHistory[]

  @@index([requesterUserId, status])
  @@index([status, submittedAt])
  @@index([agreementType])
  @@map("acordos_comerciais")
}

model CommercialAgreementClient {
  id          Int                 @id @default(autoincrement()) @map("id")
  agreementId Int                 @map("acordo_comercial_id")
  clientCode  Int                 @map("codigo_cliente")
  agreement   CommercialAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([agreementId, clientCode])
  @@index([clientCode])
  @@map("acordos_comerciais_clientes")
}

model CommercialAgreementSupplier {
  id              Int                 @id @default(autoincrement()) @map("id")
  agreementId     Int                 @map("acordo_comercial_id")
  supplierCode    Int                 @map("codigo_fornecedor")
  allocatedAmount Decimal             @map("valor_rateado") @db.Decimal(18, 2)
  agreement       CommercialAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([agreementId, supplierCode])
  @@index([supplierCode])
  @@map("acordos_comerciais_fornecedores")
}

model CommercialAgreementProduct {
  id          Int                 @id @default(autoincrement()) @map("id")
  agreementId Int                 @map("acordo_comercial_id")
  productCode Int                 @map("codigo_produto")
  agreement   CommercialAgreement @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@unique([agreementId, productCode])
  @@index([productCode])
  @@map("acordos_comerciais_produtos")
}

model CommercialAgreementAttachment {
  id               Int                                   @id @default(autoincrement()) @map("id")
  agreementId      Int                                   @map("acordo_comercial_id")
  category         CommercialAgreementAttachmentCategory @map("categoria")
  originalFileName String                                @map("nome_arquivo_original")
  storagePath      String                                @map("caminho_armazenamento")
  mimeType         String                                @map("tipo_mime")
  sizeBytes        Int                                   @map("tamanho_bytes")
  createdAt        DateTime                              @default(now()) @map("criado_em") @db.Timestamptz(3)
  agreement        CommercialAgreement                   @relation(fields: [agreementId], references: [id], onDelete: Cascade)

  @@index([agreementId, category])
  @@map("acordos_comerciais_anexos")
}

model CommercialAgreementHistory {
  id               Int                        @id @default(autoincrement()) @map("id")
  agreementId      Int                        @map("acordo_comercial_id")
  action           String                     @map("acao")
  previousStatus   CommercialAgreementStatus? @map("status_anterior")
  nextStatus       CommercialAgreementStatus? @map("status_novo")
  actorUserId      Int?                       @map("usuario_ator_id")
  actorUsername    String?                    @map("usuario_ator_login")
  actorDisplayName String?                    @map("usuario_ator_nome")
  actorRole        UserRole?                  @map("usuario_ator_perfil")
  summary          String                     @map("resumo")
  details          Json?                      @map("detalhes")
  createdAt        DateTime                   @default(now()) @map("criado_em") @db.Timestamptz(3)
  agreement        CommercialAgreement        @relation(fields: [agreementId], references: [id], onDelete: Cascade)
  actorUser        User?                      @relation("CommercialAgreementHistoryActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([agreementId, createdAt])
  @@index([actorUserId])
  @@map("historico_acordos_comerciais")
}
